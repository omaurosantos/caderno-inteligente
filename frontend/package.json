{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:node": "node --test scripts/test-page-data.mjs scripts/test-decision-journey.mjs scripts/test-validation-page.mjs scripts/test-run-comparison.mjs",
    "check:bundle": "node scripts/check-bundle-secrets.mjs",
